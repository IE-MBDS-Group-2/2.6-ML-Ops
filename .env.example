# .env.example  [Secret names, no secret values]
# -------------------------------------------------------------------
# Purpose   Tell teammates WHICH secrets and switches the project reads, without sharing values
# How       Copy to .env and fill in your own values. .env is in .gitignore; this file is committed
# Read by   src/config.py (load_env), for main.py and api.py at start-up
# Cloud     The same names are set as environment variables on the host; CI uses none of them
#
# Never paste a real key into this file, a commit, an issue or a chat.

# Weights & Biases: your own key (from your W&B user settings) and the team (entity) name
WANDB_API_KEY=
WANDB_ENTITY=ie-mbds-group-2

# online | offline | disabled. Tests and CI always run disabled (tests/conftest.py)
WANDB_MODE=disabled

# Where the API loads its model from: local (models/model.joblib) | wandb (the registry alias below)
MODEL_SOURCE=local
WANDB_MODEL_ALIAS=prod

# Shown by GET /health; the deploy sets it to the release tag
APP_VERSION=dev

# Shown by GET /health as "commit". the release image has it baked in; leave it as local on your machine
APP_COMMIT=local
